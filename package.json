{
  "name": "biotracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file=api/.env api/src/server.ts",
    "start:api": "tsx --env-file=api/.env api/src/server.ts",
    "build": "tsc -b && vite build",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:api": "node --import tsx --env-file=api/.env.test --test --test-concurrency=1 \"api/tests/**/*.test.ts\"",
    "db:generate": "cd api && drizzle-kit generate",
    "db:migrate": "cd api && drizzle-kit migrate",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.9.0",
    "lucide-react": "^1.14.0",
    "pg": "^8.22.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
